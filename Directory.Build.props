<!--
  Shared by every plugin in this repository. A plugin builds against DevHub's Sdk (DevHub.Sdk.dll +
  DevHub.Sdk.Core.dll), which DevHub ships, so they're referenced but never copied into the plugin's
  package; the same for Avalonia, CommunityToolkit.Mvvm and DI, which DevHub already has (keep their
  versions equal to DevHub's: see README.md).

  The Sdk comes from DevHubSdkDir: by default .sdk/ (filled by build/Get-Sdk.ps1 from DevHub's latest
  release); point it at a local DevHub build to work against unreleased changes:
    dotnet build -p:DevHubSdkDir=C:\P\DevHub\DevHub\src\DevHub.Sdk\bin\Debug\net10.0\
-->
<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DevHub</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <DevHubSdkDir Condition="'$(DevHubSdkDir)' == ''">$(MSBuildThisFileDirectory).sdk\</DevHubSdkDir>
        <!-- Every DLL of the plugin goes into its package; nothing else is copied. -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="DevHub.Sdk" HintPath="$(DevHubSdkDir)DevHub.Sdk.dll" Private="false" />
        <Reference Include="DevHub.Sdk.Core" HintPath="$(DevHubSdkDir)DevHub.Sdk.Core.dll" Private="false" />
        <!-- Build-time only: DevHub provides these at run time (ExcludeAssets="runtime"). -->
        <PackageReference Include="Avalonia" Version="12.1.3" ExcludeAssets="runtime" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
