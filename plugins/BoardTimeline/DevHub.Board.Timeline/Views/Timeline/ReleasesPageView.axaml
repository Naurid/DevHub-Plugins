<!-- Releases: the versions on the left, the chosen one's issues and release notes on the right. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevHub.ViewModels.Timeline"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Timeline.ReleasesPageView"
             x:DataType="vm:ReleasesPageViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DevHub.Board/Views/Board/BoardTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://DevHub.Board/Views/Board/BoardStyles.axaml" />
    </UserControl.Styles>

    <DockPanel>
        <DockPanel DockPanel.Dock="Left" Width="{DynamicResource Size.EpicsPanel}">
            <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource Padding.BoardHeader}" Spacing="{DynamicResource Spacing.Small}">
                <Button Content="New Version…" Command="{Binding NewVersionCommand}" HorizontalAlignment="Stretch" />
                <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Releases">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReleaseRow">
                        <StackPanel Spacing="{DynamicResource Spacing.Small}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <ProgressBar Value="{Binding Fraction}" Maximum="1" />
                            <TextBlock Classes="small secondary" Text="{Binding Detail}" Classes.overdue="{Binding IsLate}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Panel>
            <c:EmptyState IconKind="info" Title="No versions yet" IsVisible="{Binding !HasSelection}"
                          Description="Versions are the releases issues are planned for (an issue's Fix versions). Create one to see its progress and release notes." />
            <ScrollViewer IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{DynamicResource Padding.Board}" Spacing="{DynamicResource Spacing}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing}">
                        <TextBlock Classes="header" Text="{Binding Selected.Name}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Save Release Notes…" Command="{Binding SaveNotesCommand}" />
                        <Button Grid.Column="2" Classes="accent" Content="Release…" Command="{Binding ReleaseCommand}" IsVisible="{Binding CanRelease}" />
                    </Grid>
                    <TextBlock Classes="secondary" Text="{Binding Selected.Detail}" />
                    <TextBlock Classes="section" Text="Issues" />
                    <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueRow}" />
                    <TextBlock Classes="section" Text="Release notes" />
                    <Border Classes="listPanel">
                        <c:MarkdownView Markdown="{Binding Notes}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
