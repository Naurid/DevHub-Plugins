<!-- Publish to GitHub: account (when several), name (+ where it will be), description, private, remote name. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevHub.ViewModels.Git"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Git.PublishToGitHubDialogView"
             x:DataType="vm:PublishToGitHubDialogViewModel">
    <StackPanel Margin="{DynamicResource Padding.Dialog}" Spacing="{DynamicResource Spacing}">
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="Creates an empty repository on GitHub under your account, adds it as a remote, and pushes the current branch to it." />

        <StackPanel Spacing="{DynamicResource Spacing}" IsVisible="{Binding HasSeveralAccounts}">
            <TextBlock Classes="secondary" Text="Account" />
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="GitHub account" />
        </StackPanel>

        <TextBlock Classes="secondary" Text="Repository name" />
        <TextBox Text="{Binding Name}" AutomationProperties.Name="Repository name" c:FocusOnLoad.IsEnabled="True" />
        <TextBlock Classes="small secondary" Text="{Binding Preview}" />

        <TextBlock Classes="secondary" Text="Description (optional)" />
        <TextBox Text="{Binding Description}" AutomationProperties.Name="Description" />

        <CheckBox Content="Private (only you and people you invite can see it)" IsChecked="{Binding IsPrivate}" />

        <TextBlock Classes="secondary" Text="Remote name" />
        <TextBox Text="{Binding RemoteName}" AutomationProperties.Name="Remote name" />

        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Status.Error}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
