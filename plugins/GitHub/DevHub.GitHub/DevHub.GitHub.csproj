<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The GitHub plugin's UI: the account (Settings → GitHub), Publish to GitHub, and Git's
      IRemoteHost for it. Requires the Git plugin, so it may reference DevHub.Git (never the reverse).
    -->

    <PropertyGroup>
        <RootNamespace>DevHub</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DevHub.Sdk\DevHub.Sdk.csproj" />
        <ProjectReference Include="..\DevHub.Git\DevHub.Git.csproj" />
        <ProjectReference Include="..\DevHub.GitHub.Core\DevHub.GitHub.Core.csproj" />
    </ItemGroup>

</Project>
