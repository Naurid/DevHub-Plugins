<!-- Status bar: the CI of the branch in front (✓ CI green, ✗ CI red, ● CI accent); a click shows the CI tool window. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevHub.ViewModels.Ci"
             x:Class="DevHub.Views.Ci.CiStatusWidgetView"
             x:DataType="vm:CiStatusWidgetViewModel">
    <UserControl.Styles>
        <Style Selector="Button.ci.passed">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
        </Style>
        <Style Selector="Button.ci.failed">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
        </Style>
        <Style Selector="Button.ci.active">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
    </UserControl.Styles>
    <Button Classes="statusWidget ci" Classes.passed="{Binding IsPassed}" Classes.failed="{Binding IsFailed}" Classes.active="{Binding IsActive}"
            Content="{Binding Text}" ToolTip.Tip="{Binding ToolTip}" Command="{Binding ShowRunsCommand}"
            IsVisible="{Binding IsVisible}" AutomationProperties.Name="{Binding ToolTip}" />
</UserControl>
