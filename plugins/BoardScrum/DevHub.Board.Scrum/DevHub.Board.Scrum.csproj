<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Board.Scrum: sprints for the Board plugin (docs/BOARD_PLAN.md, B7). Sprint planning (the Backlog of a Scrum
      board, with a list per sprint), Start / Complete / Edit Sprint, capacity. The sprint rules live in
      DevHub.Board.Core (search and reports understand sprints without this plugin). Requires Board, so it may
      reference DevHub.Board (never the reverse).
    -->

    <PropertyGroup>
        <RootNamespace>DevHub</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Board\DevHub.Board\DevHub.Board.csproj" />
    </ItemGroup>

</Project>
