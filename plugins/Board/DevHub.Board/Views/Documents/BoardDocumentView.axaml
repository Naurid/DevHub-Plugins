<!--
  A board tab: header (board selector, pages, search, Create, the board menu), the page, and the issue panel on the
  right (resizable). Before the board loads: a message, with "Create Board…" when there's none here yet.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels.Documents"
             xmlns:core="using:DevHub.Board.Core.Model"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Documents.BoardDocumentView"
             x:DataType="vm:BoardDocumentViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://DevHub.Board/Views/Board/BoardStyles.axaml" />
        <Style Selector="ListBox.pages > ListBoxItem">
            <Setter Property="Padding" Value="{DynamicResource Padding.Tab}" />
            <Setter Property="Margin" Value="{DynamicResource Margin.InnerRight}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Not loaded: loading, no board here, or an error. -->
        <c:EmptyState IconKind="menu" Title="{l:T 'Board'}" Description="{Binding Message}" IsVisible="{Binding !IsLoaded}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}" HorizontalAlignment="Center">
                <Button Classes="accent" Content="{l:T 'Create Board…'}" Command="{Binding CreateBoardHereCommand}" IsVisible="{Binding CanCreateHere}" />
                <Button Content="{l:T 'Try Again'}" Command="{Binding RetryCommand}"
                        IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </c:EmptyState>

        <DockPanel IsVisible="{Binding IsLoaded}">
            <Border DockPanel.Dock="Top" Classes="pageHeader">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Spacing}">
                    <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" VerticalAlignment="Center"
                              AutomationProperties.Name="{l:T 'Board'}" ToolTip.Tip="{l:T 'Which board of this project to show'}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:BoardDefinition">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ListBox Grid.Column="1" Classes="pages" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                             Background="Transparent" AutomationProperties.Name="{l:T 'Pages'}" VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- Wraps onto a second line when the pages don't fit beside the search box (a narrow window). -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BoardPageTab">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <c:SearchField Grid.Column="2" Text="{Binding Search}" PlaceholderText="{l:T 'Search this board'}"
                                   Width="{DynamicResource Size.BoardSearch}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="accent" Content="{l:T 'Create'}" Command="{Binding CreateIssueCommand}"
                            ToolTip.Tip="{l:T 'Create an issue (Ctrl+Alt+I)'}" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Classes="flat" ToolTip.Tip="{l:T 'Board menu'}" AutomationProperties.Name="{l:T 'Board menu'}"
                            VerticalAlignment="Center">
                        <c:Icon Kind="moreVertical" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{l:T 'Board Settings…'}" Command="{Binding BoardSettingsCommand}" />
                                <MenuItem Header="{l:T 'New Board View…'}" Command="{Binding NewBoardViewCommand}" />
                                <MenuItem Header="{l:T 'Delete This Board View…'}" Command="{Binding DeleteBoardViewCommand}" />
                                <Separator />
                                <MenuItem Header="{l:T 'Project Settings (workflows, statuses, types, fields…)'}" Command="{Binding ProjectSettingsCommand}" />
                                <Separator />
                                <MenuItem Header="{Binding UndoText, StringFormat={l:T 'Undo: {0}'}, TargetNullValue={l:T 'Undo'}}" Command="{Binding UndoCommand}"
                                          IsEnabled="{Binding UndoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <MenuItem Header="{l:T 'Reload from Disk'}" Command="{Binding ReloadCommand}" />
                                <MenuItem Header="{l:T 'Copy Board To… (another folder, a repository branch)'}" Command="{Binding CopyBoardCommand}" />
                                <Separator />
                                <MenuItem Header="{l:T 'Import Issues… (Jira CSV, GitHub)'}" Command="{Binding ImportIssuesCommand}" />
                                <MenuItem Header="{l:T 'Export Issues as CSV…'}" Command="{Binding ExportCsvCommand}" />
                                <MenuItem Header="{l:T 'Export Board as JSON…'}" Command="{Binding ExportJsonCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <DockPanel>
                <Border DockPanel.Dock="Right" Width="{Binding IssuePanelWidth}" Background="{DynamicResource Brush.Bg.Panel}"
                        IsVisible="{Binding HasIssuePanel}">
                    <ContentControl Content="{Binding IssuePanel}" />
                </Border>
                <c:SplitterThumb DockPanel.Dock="Right" Value="{Binding IssuePanelWidth}" Orientation="Vertical" Invert="True"
                                 Minimum="{DynamicResource Size.IssuePanelMin}" IsVisible="{Binding HasIssuePanel}" />
                <ContentControl Content="{Binding Page}" />
            </DockPanel>
        </DockPanel>
    </Panel>
</UserControl>
