<!-- Import Issues: the source, its file or repository, Load, and what would happen. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels.Dialogs"
             x:Class="DevHub.Views.Dialogs.ImportDialogView"
             x:DataType="vm:ImportDialogViewModel">
    <DockPanel Margin="{DynamicResource Padding.Dialog}">
        <StackPanel DockPanel.Dock="Top" Spacing="{DynamicResource Spacing}">
            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                <TextBlock Classes="secondary" Text="{l:T 'From'}" />
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Import from'}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing}" IsVisible="{Binding IsJira}">
                <TextBox Text="{Binding File}" PlaceholderText="{l:T 'Jira\'s CSV export (all fields)'}" AutomationProperties.Name="{l:T 'CSV file'}" />
                <Button Grid.Column="1" Content="{l:T 'Browse…'}" Command="{Binding BrowseCommand}" />
                <Button Grid.Column="2" Content="{l:T 'Load'}" Command="{Binding LoadCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing}" IsVisible="{Binding !IsJira}">
                <TextBox Text="{Binding Repository}" PlaceholderText="{l:T 'owner/name'}" AutomationProperties.Name="{l:T 'GitHub repository'}" />
                <Button Grid.Column="1" Content="{l:T 'Load'}" Command="{Binding LoadCommand}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Status.Error}" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <ScrollViewer Margin="{DynamicResource Margin.BlockBelow}">
            <SelectableTextBlock Text="{Binding Preview}" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
