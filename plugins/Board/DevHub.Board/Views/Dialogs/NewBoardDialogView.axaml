<!-- New Board: name and key, a preset, and where to keep it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels.Dialogs"
             xmlns:core="using:DevHub.Board.Core"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Dialogs.NewBoardDialogView"
             x:DataType="vm:NewBoardDialogViewModel">
    <StackPanel Margin="{DynamicResource Padding.Dialog}" Spacing="{DynamicResource Spacing}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing}">
            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                <TextBlock Classes="secondary" Text="{l:T 'Name'}" />
                <TextBox Text="{Binding Name}" PlaceholderText="{l:T 'My project'}" AutomationProperties.Name="{l:T 'Board name'}" c:FocusOnLoad.IsEnabled="True" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.Small}">
                <TextBlock Classes="secondary" Text="{l:T 'Key'}" ToolTip.Tip="{l:T 'Issue keys start with it: DEV-1, DEV-2…'}" />
                <TextBox Text="{Binding Key}" PlaceholderText="{l:T 'DEV'}" AutomationProperties.Name="{l:T 'Project key'}" MinWidth="{DynamicResource Size.IssueKey}" />
            </StackPanel>
        </Grid>
        <StackPanel Spacing="{DynamicResource Spacing.Small}">
            <TextBlock Classes="secondary" Text="{l:T 'Start with'}" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Preset'}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:BoardPreset">
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="small secondary" Text="{Binding PresetDescription}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="{DynamicResource Spacing.Small}">
            <TextBlock Classes="secondary" Text="{l:T 'Keep it'}" />
            <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding Store}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Where to keep it'}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StoreChoice">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Classes="small secondary" Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing}" IsVisible="{Binding ShowFolder}">
                <TextBox Text="{Binding Folder}" PlaceholderText="{l:T 'A folder (for a repository: its root folder)'}" AutomationProperties.Name="{l:T 'Folder'}" />
                <Button Grid.Column="1" Content="{l:T 'Browse…'}" Command="{Binding BrowseCommand}" />
            </Grid>
        </StackPanel>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Status.Error}" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
