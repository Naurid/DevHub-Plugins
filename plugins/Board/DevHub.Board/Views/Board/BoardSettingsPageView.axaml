<!-- Settings → Board: who you are on boards, and card density. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevHub.ViewModels.Board"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Board.BoardSettingsPageView"
             x:DataType="vm:BoardSettingsPageViewModel">
    <StackPanel Spacing="{DynamicResource Spacing}">
        <c:SettingsRow Label="Your name" Description="How you appear on boards (assignee, reporter, comments). Empty: your Windows user name.">
            <TextBox Text="{Binding UserName}" PlaceholderText="{Binding DefaultName}" AutomationProperties.Name="Your name" />
        </c:SettingsRow>
        <c:SettingsRow Label="Your email" Description="Optional. Matches you on a board someone else started, and to git authors.">
            <TextBox Text="{Binding UserEmail}" PlaceholderText="you@example.com" AutomationProperties.Name="Your email" />
        </c:SettingsRow>
        <c:SettingsRow Label="Compact cards" Description="Smaller cards on boards.">
            <CheckBox IsChecked="{Binding CompactCards}" AutomationProperties.Name="Compact cards" />
        </c:SettingsRow>
    </StackPanel>
</UserControl>
