<!--
  The Search page: a query (with examples and help), saved filters, and the results as a list or as a board.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevHub.ViewModels.Board"
             xmlns:core="using:DevHub.Board.Core.Model"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Board.SearchPageView"
             x:DataType="vm:SearchPageViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DevHub.Board/Views/Board/BoardTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://DevHub.Board/Views/Board/BoardStyles.axaml" />
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="pageHeader">
            <StackPanel Spacing="{DynamicResource Spacing}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing}">
                    <TextBox Classes="code" Text="{Binding Query}" AutomationProperties.Name="Query"
                             PlaceholderText="type = bug AND assignee = currentUser() ORDER BY priority DESC">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding RunCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="accent" Content="Search" Command="{Binding RunCommand}" />
                    <Button Grid.Column="2" Classes="flat" ToolTip.Tip="Help and examples" AutomationProperties.Name="Query help">
                        <c:Icon Kind="info" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="{DynamicResource Spacing}" MaxWidth="{DynamicResource Size.IssuePanel}">
                                    <TextBlock Text="{Binding Help}" TextWrapping="Wrap" />
                                    <TextBlock Classes="section" Text="Examples" />
                                    <ItemsControl ItemsSource="{Binding Examples}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Classes="flat" HorizontalAlignment="Left" Content="{Binding}"
                                                        Command="{Binding $parent[UserControl].((vm:SearchPageViewModel)DataContext).UseExampleCommand}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Status.Error}" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing}">
                    <TextBlock Classes="secondary" Text="Saved:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" PlaceholderText="Saved filters"
                              AutomationProperties.Name="Saved filters">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:SavedFilter">
                                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Query}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Classes="flat" Content="Save…" Command="{Binding SaveFilterCommand}" />
                    <Button Grid.Column="3" Classes="flat" Content="Delete" Command="{Binding DeleteFilterCommand}"
                            IsEnabled="{Binding SelectedFilter, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Grid.Column="4" Classes="secondary" Text="{Binding ResultText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <ToggleButton Grid.Column="5" Classes="chip" Content="As board" IsChecked="{Binding AsBoard}" />
                    <Button Grid.Column="6" Classes="flat" Content="Edit All…" Command="{Binding BulkEditResultsCommand}"
                            ToolTip.Tip="Change a field of every issue found" />
                </Grid>
            </StackPanel>
        </Border>

        <Panel>
            <!-- As a list. -->
            <ListBox ItemsSource="{Binding Results}" IsVisible="{Binding !AsBoard}" Background="Transparent"
                     AutomationProperties.Name="Results" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing}">
                            <Button Classes="cardButton" Command="{Binding Item.SelectCommand}" AutomationProperties.Name="{Binding Item}"
                                    Content="{Binding Item}" ContentTemplate="{StaticResource IssueRow}" />
                            <TextBlock Grid.Column="1" Classes="small secondary" Text="{Binding Updated}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- As a board (the shown board's columns). -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding AsBoard}">
                <ItemsControl ItemsSource="{Binding Columns}" Margin="{DynamicResource Padding.Board}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Size.BoardColumnSpacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchColumn">
                            <StackPanel Spacing="{DynamicResource Spacing}">
                                <Border Classes="columnHeader">
                                    <TextBlock Classes="columnName" Text="{Binding Header}" />
                                </Border>
                                <Border Classes="boardColumn">
                                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource IssueCard}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
