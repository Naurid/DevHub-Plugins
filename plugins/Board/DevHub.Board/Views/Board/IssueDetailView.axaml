<!--
  One issue, every field editable in place (the board's side panel and the issue tab). Text fields save when they
  lose focus; drop-downs save at once. Sections: description, details, sub-tasks (or an epic's issues), links,
  attachments, other plugins' sections, and activity (comments, work log, history).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevHub.ViewModels.Board"
             xmlns:dlg="using:DevHub.ViewModels.Dialogs"
             xmlns:board="using:DevHub.Board"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Board.IssueDetailView"
             x:DataType="vm:IssueDetailViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DevHub.Board/Views/Board/BoardTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="NamedWithIcon" x:DataType="dlg:NamedItem">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Small}">
                    <c:IssueTypeIcon Kind="{Binding Icon}" IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="NamedWithPriority" x:DataType="dlg:NamedItem">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Small}">
                    <c:PriorityIcon Kind="{Binding Icon}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://DevHub.Board/Views/Board/BoardStyles.axaml" />
        <Style Selector="TextBox.summary">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Header}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="StackPanel.fields > Grid">
            <Setter Property="MinHeight" Value="{DynamicResource Size.RowHeight}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource Padding.IssuePanel}" Spacing="{DynamicResource Spacing.Large}">

            <!-- Header: type, key, parent; open in tab, menu, close. -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                <c:IssueTypeIcon Kind="{Binding TypeIcon}" ToolTip.Tip="{Binding TypeName}" VerticalAlignment="Center" />
                <SelectableTextBlock Grid.Column="1" Classes="secondary" Text="{Binding Key}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="flat" HorizontalAlignment="Left" Command="{Binding GoToCommand}" CommandParameter="{Binding ParentId}"
                        IsVisible="{Binding ParentKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{Binding ParentSummary}">
                    <TextBlock Classes="small" TextTrimming="CharacterEllipsis">
                        <Run Text="in " /><Run Text="{Binding ParentKey}" /><Run Text=" " /><Run Text="{Binding ParentSummary}" />
                    </TextBlock>
                </Button>
                <Button Grid.Column="3" Classes="flat" ToolTip.Tip="Open in its own tab" AutomationProperties.Name="Open in tab"
                        Command="{Binding OpenTabCommand}" IsVisible="{Binding IsPanel}">
                    <c:Icon Kind="externalTools" />
                </Button>
                <Button Grid.Column="4" Classes="flat" ToolTip.Tip="More" AutomationProperties.Name="Issue menu">
                    <c:Icon Kind="moreVertical" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Clone" Command="{Binding CloneCommand}" />
                            <MenuItem Header="Log Work…" Command="{Binding LogWorkCommand}" />
                            <MenuItem Header="Attach File…" Command="{Binding AddAttachmentCommand}" />
                            <MenuItem Header="Link Issue…" Command="{Binding StartAddLinkCommand}" />
                            <Separator />
                            <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="5" Classes="flat" ToolTip.Tip="Close" AutomationProperties.Name="Close issue panel"
                        Command="{Binding ClosePanelCommand}" IsVisible="{Binding IsPanel}">
                    <c:Icon Kind="close" />
                </Button>
            </Grid>

            <!-- Actions other plugins add (Board.Git: Create Branch). -->
            <ItemsControl ItemsSource="{Binding PluginActions}" IsVisible="{Binding HasPluginActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="board:IssueAction">
                        <Button Content="{Binding Text}" IsEnabled="{Binding IsEnabled}" Margin="{DynamicResource Margin.RowEnd}"
                                Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).RunPluginActionCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Classes="summary" Text="{Binding Summary, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Summary" />

            <!-- Status and resolution. -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource Spacing}">
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" AutomationProperties.Name="Status"
                          ToolTip.Tip="Move to another status (only the moves the workflow allows are listed)" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" IsVisible="{Binding IsDone}"
                          AutomationProperties.Name="Resolution" ToolTip.Tip="Resolution" />
                <TextBlock Grid.Column="2" Classes="small secondary" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Created}" /><Run Text=" · " /><Run Text="{Binding Updated}" />
                </TextBlock>
            </Grid>

            <!-- Description. -->
            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="Description" />
                    <Button Grid.Column="1" Classes="flat" Content="Edit" Command="{Binding EditDescriptionCommand}" IsVisible="{Binding !IsEditingDescription}" />
                </Grid>
                <c:MarkdownView Markdown="{Binding Description}" IsVisible="{Binding !IsEditingDescription}" />
                <Button Classes="flat" HorizontalAlignment="Left" Content="Add a description…" Command="{Binding EditDescriptionCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!HasDescription" />
                            <Binding Path="!IsEditingDescription" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>
                <StackPanel Spacing="{DynamicResource Spacing.Small}" IsVisible="{Binding IsEditingDescription}">
                    <TextBox Text="{Binding DescriptionDraft}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="{DynamicResource Size.DescriptionEditor}"
                             AutomationProperties.Name="Description (Markdown)" c:FocusOnLoad.IsEnabled="True"
                             PlaceholderText="Markdown: **bold**, *italic*, `code`, - lists, - [ ] tasks, [links](https://…)" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                        <Button Classes="accent" Content="Save" Command="{Binding SaveDescriptionCommand}" />
                        <Button Content="Cancel" Command="{Binding CancelDescriptionCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Details. -->
            <StackPanel Classes="fields" Spacing="{DynamicResource Spacing.Small}">
                <TextBlock Classes="section" Text="Details" />
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Type" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" ItemTemplate="{StaticResource NamedWithIcon}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Type" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Priority" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" ItemTemplate="{StaticResource NamedWithPriority}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Priority" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                    <TextBlock Classes="fieldLabel" Text="Assignee" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding People}" SelectedItem="{Binding Assignee}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Assignee" />
                    <Button Grid.Column="2" Classes="flat" Content="Assign to me" Command="{Binding AssignToMeCommand}" IsVisible="{Binding !IsAssignedToMe}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Reporter" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding People}" SelectedItem="{Binding Reporter}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Reporter" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowParent}">
                    <TextBlock Classes="fieldLabel" Text="{Binding ParentLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Parents}" SelectedItem="{Binding Parent}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{Binding ParentLabel}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowSprint}">
                    <TextBlock Classes="fieldLabel" Text="Sprint" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SprintChoices}" SelectedItem="{Binding Sprint}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Sprint" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowPoints}">
                    <TextBlock Classes="fieldLabel" Text="Story points" />
                    <TextBox Grid.Column="1" Text="{Binding Points, UpdateSourceTrigger=LostFocus}" PlaceholderText="None" AutomationProperties.Name="Story points" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Original estimate" />
                    <TextBox Grid.Column="1" Text="{Binding OriginalEstimate, UpdateSourceTrigger=LostFocus}" PlaceholderText="e.g. 1d 4h"
                             AutomationProperties.Name="Original estimate" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Remaining" />
                    <TextBox Grid.Column="1" Text="{Binding RemainingEstimate, UpdateSourceTrigger=LostFocus}" PlaceholderText="e.g. 4h"
                             AutomationProperties.Name="Remaining estimate" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                    <TextBlock Classes="fieldLabel" Text="Time tracking" />
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.Small}" VerticalAlignment="Center">
                        <ProgressBar Value="{Binding TimeProgress}" Maximum="1" />
                        <TextBlock Classes="small secondary" Text="{Binding TimeSpent}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="flat" Content="Log work…" Command="{Binding LogWorkCommand}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Start date" />
                    <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Start}" HorizontalAlignment="Stretch" AutomationProperties.Name="Start date" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Due date" />
                    <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Due}" HorizontalAlignment="Stretch" AutomationProperties.Name="Due date" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="fieldLabel" Text="Labels" />
                    <TextBox Grid.Column="1" Text="{Binding Labels, UpdateSourceTrigger=LostFocus}" PlaceholderText="ui backend (separated by spaces)"
                             AutomationProperties.Name="Labels" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" IsVisible="{Binding HasComponents}">
                    <TextBlock Classes="fieldLabel" Text="Components" />
                    <TextBlock Grid.Column="1" Text="{Binding Components, TargetNullValue='None'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="flat" Content="Change…" Command="{Binding EditComponentsCommand}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" IsVisible="{Binding HasVersions}">
                    <TextBlock Classes="fieldLabel" Text="Fix versions" />
                    <TextBlock Grid.Column="1" Text="{Binding FixVersions}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="flat" Content="Change…" Command="{Binding EditVersionsCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CustomFields}" IsVisible="{Binding HasCustomFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CustomFieldRow">
                            <Grid ColumnDefinitions="Auto,*" MinHeight="{DynamicResource Size.RowHeight}">
                                <TextBlock Classes="fieldLabel" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Placeholder}"
                                         IsVisible="{Binding !IsChoice}" AutomationProperties.Name="{Binding Name}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch"
                                          IsVisible="{Binding IsChoice}" AutomationProperties.Name="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Sub-tasks, or an epic's issues. -->
            <StackPanel Spacing="{DynamicResource Spacing.Small}" IsVisible="{Binding CanHaveChildren}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="{Binding ChildrenTitle}" />
                    <TextBlock Grid.Column="1" Classes="small secondary" Text="{Binding ChildrenProgress}" />
                </Grid>
                <ProgressBar Value="{Binding ChildrenDone}" Maximum="1"
                             IsVisible="{Binding ChildrenProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding Children}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueItemViewModel">
                            <Button Classes="cardButton" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding}"
                                    ToolTip.Tip="Show it (double-click: open in a tab)"
                                    Content="{Binding}" ContentTemplate="{StaticResource IssueRow}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                    <TextBox Text="{Binding NewChildSummary}" PlaceholderText="Add: what needs to be done? (Enter)" AutomationProperties.Name="New child issue">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddChildCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Add" Command="{Binding AddChildCommand}" />
                </Grid>
            </StackPanel>

            <!-- Links. -->
            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="Links" />
                    <Button Grid.Column="1" Classes="flat" Content="Link issue…" Command="{Binding StartAddLinkCommand}" IsVisible="{Binding !IsAddingLink}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkRow">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" MinHeight="{DynamicResource Size.RowHeight}">
                                <TextBlock Classes="secondary" Text="{Binding Phrase}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="flat" Content="{Binding OtherKey}" ToolTip.Tip="{Binding OtherSummary}"
                                        Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).GoToLinkCommand}" CommandParameter="{Binding}" />
                                <TextBlock Grid.Column="2" Text="{Binding OtherSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="3" Classes="statusPill" Classes.done="{Binding OtherDone}" VerticalAlignment="Center">
                                    <TextBlock Classes="small" Text="{Binding OtherStatus}" />
                                </Border>
                                <Button Grid.Column="4" Classes="flat" ToolTip.Tip="Remove the link" AutomationProperties.Name="Remove link"
                                        Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).RemoveLinkCommand}" CommandParameter="{Binding}">
                                    <c:Icon Kind="close" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" IsVisible="{Binding IsAddingLink}">
                    <ComboBox ItemsSource="{Binding LinkChoices}" SelectedItem="{Binding NewLinkType}" AutomationProperties.Name="Link type" />
                    <TextBox Grid.Column="1" Text="{Binding NewLinkKey}" PlaceholderText="Issue key, e.g. DEV-7" AutomationProperties.Name="Issue to link"
                             c:FocusOnLoad.IsEnabled="True">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddLinkCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="2" Content="Link" Command="{Binding AddLinkCommand}" />
                </Grid>
            </StackPanel>

            <!-- Attachments. -->
            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="Attachments" />
                    <Button Grid.Column="1" Classes="flat" Content="Attach…" Command="{Binding AddAttachmentCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentRow">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" MinHeight="{DynamicResource Size.RowHeight}">
                                <Button Classes="flat" HorizontalAlignment="Left" ToolTip.Tip="Open"
                                        Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).OpenAttachmentCommand}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                </Button>
                                <TextBlock Grid.Column="1" Classes="small secondary" Text="{Binding Size}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="small secondary" Text="{Binding When}" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Classes="flat" ToolTip.Tip="Remove" AutomationProperties.Name="Remove attachment"
                                        Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}">
                                    <c:Icon Kind="delete" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Sections from other plugins (their views come from their own assemblies). -->
            <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding HasSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="board:IssueSectionViewModel">
                        <StackPanel Spacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.BlockBelow}">
                            <TextBlock Classes="section" Text="{Binding Title}" />
                            <ContentControl Content="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Activity. -->
            <TabControl SelectedIndex="{Binding ActivityTab}">
                <TabItem Header="Comments">
                    <StackPanel Spacing="{DynamicResource Spacing}">
                        <TextBox Text="{Binding NewComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="{DynamicResource Size.CommentEditor}"
                                 PlaceholderText="Add a comment (Markdown)…" AutomationProperties.Name="New comment" />
                        <Button Classes="accent" Content="Comment" Command="{Binding AddCommentCommand}" HorizontalAlignment="Left" />
                        <StackPanel Spacing="{DynamicResource Spacing.Small}"
                                    IsVisible="{Binding EditingCommentId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="secondary" Text="Editing a comment" />
                            <TextBox Text="{Binding EditingCommentText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="{DynamicResource Size.CommentEditor}"
                                     AutomationProperties.Name="Comment being edited" />
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                                <Button Classes="accent" Content="Save" Command="{Binding SaveCommentCommand}" />
                                <Button Content="Cancel" Command="{Binding CancelCommentEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Comments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CommentRow">
                                    <StackPanel Spacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.BlockBelow}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                                            <c:Avatar Text="{Binding Author}" Width="{DynamicResource Size.AvatarSmall}" Height="{DynamicResource Size.AvatarSmall}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Author}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="small secondary" VerticalAlignment="Center">
                                                <Run Text="{Binding WhenText}" />
                                            </TextBlock>
                                            <Button Grid.Column="3" Classes="flat" Content="Edit" IsVisible="{Binding IsMine}"
                                                    Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).EditCommentCommand}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="4" Classes="flat" Content="Delete" IsVisible="{Binding IsMine}"
                                                    Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).DeleteCommentCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <c:MarkdownView Markdown="{Binding Body}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Work log">
                    <StackPanel Spacing="{DynamicResource Spacing}">
                        <Button Content="Log Work…" Command="{Binding LogWorkCommand}" HorizontalAlignment="Left" />
                        <TextBlock Classes="secondary" Text="No work logged yet." IsVisible="{Binding !HasWorkLogs}" />
                        <ItemsControl ItemsSource="{Binding WorkLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkLogRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.BlockBelow}">
                                        <c:Avatar Text="{Binding Author}" Width="{DynamicResource Size.AvatarSmall}" Height="{DynamicResource Size.AvatarSmall}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Author}" FontWeight="SemiBold" /><Run Text=" logged " /><Run Text="{Binding Spent}" />
                                                <Run Text=" · " /><Run Text="{Binding When}" />
                                            </TextBlock>
                                            <TextBlock Classes="secondary" Text="{Binding Note}" TextWrapping="Wrap"
                                                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="flat" Content="Delete" IsVisible="{Binding IsMine}" VerticalAlignment="Top"
                                                Command="{Binding $parent[UserControl].((vm:IssueDetailViewModel)DataContext).DeleteWorkLogCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
                <TabItem Header="History">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRow">
                                <TextBlock TextWrapping="Wrap" Margin="{DynamicResource Margin.BlockBelow}">
                                    <Run Text="{Binding Who}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Text}" />
                                    <Run Text=" · " Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <Run Text="{Binding When}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
