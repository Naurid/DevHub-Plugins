{
  // A .NET console app the way many repos lay it out: the project in src/<Name>, a solution at the
  // root, a README and a .gitignore. `dotnet new console` makes the project; the steps move it
  // into src/; the post-create commands make the solution (and a git repository if you want one).
  "schemaVersion": 1,
  "id": "dotnet-console",
  "kind": "project",
  "name": "Console App",
  "description": "A .NET console app in src/<Name>, with a solution, a README and a .gitignore.",
  "language": "C#",
  "categories": ["Console", ".NET"],
  "variables": [
    { "name": "Name", "label": "Project name", "required": true, "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
    { "name": "Git", "label": "Create a git repository", "type": "bool", "default": true }
  ],
  "baseCommand": {
    "command": "dotnet",
    "args": ["new", "console", "--name", "{{Name}}", "--output", ".", "--no-restore"]
  },
  "steps": [
    { "op": "move", "from": "*.cs", "to": "src/{{Name}}/" },
    { "op": "move", "from": "{{Name}}.csproj", "to": "src/{{Name}}/" }
  ],
  "postCreate": [
    { "name": "Create the solution", "command": "dotnet", "args": ["new", "sln", "--name", "{{Name}}"] },
    { "name": "Add the project to the solution", "command": "dotnet", "args": ["sln", "add", "src/{{Name}}/{{Name}}.csproj"] },
    { "name": "Initialize git", "command": "git", "args": ["init"], "when": "Git", "continueOnError": true }
  ]
}
