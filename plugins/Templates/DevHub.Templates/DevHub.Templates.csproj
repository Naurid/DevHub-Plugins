<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Templates plugin's UI: New Project (browser + generation flow), its actions and dialogs.
      The engine is DevHub.Templates.Core (no Avalonia).
    -->

    <PropertyGroup>
        <RootNamespace>DevHub</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevHub.Templates.Core\DevHub.Templates.Core.csproj" />
    </ItemGroup>

</Project>
