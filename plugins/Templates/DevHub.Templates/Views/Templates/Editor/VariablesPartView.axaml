<!-- Template editor → Variables: the list (add, remove, reorder) and the selected variable's settings. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:e="using:DevHub.ViewModels.Templates.Editor"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Templates.Editor.VariablesPartView"
             x:DataType="e:VariablesPartViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="secondary" TextWrapping="Wrap" Margin="{DynamicResource Margin.BlockBelow}"
                   Text="{l:T 'The fields of New Project\'s form. Use a variable as {{Name}} in file contents, file names, the project folder, steps and commands.'}" />

        <!-- The list -->
        <Border DockPanel.Dock="Left" Width="{DynamicResource Size.EditorList}" BorderBrush="{DynamicResource Brush.Border.Control}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Margin="{DynamicResource Margin.RowEnd}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="{DynamicResource Padding.Toolbar}">
                    <c:Toolbar>
                        <c:ActionButton IconKind="add" ToolTip.Tip="{l:T 'Add Variable'}" AutomationProperties.Name="{l:T 'Add Variable'}" Command="{Binding AddCommand}" />
                        <c:ActionButton IconKind="delete" ToolTip.Tip="{l:T 'Remove'}" AutomationProperties.Name="{l:T 'Remove'}" Command="{Binding RemoveCommand}" />
                        <c:ToolbarSeparator />
                        <Button Classes="flat" Content="{l:T 'Up'}" ToolTip.Tip="{l:T 'Move Up'}" Command="{Binding MoveUpCommand}" />
                        <Button Classes="flat" Content="{l:T 'Down'}" ToolTip.Tip="{l:T 'Move Down'}" Command="{Binding MoveDownCommand}" />
                    </c:Toolbar>
                </Border>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:T 'Variables'}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="e:VariableItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing}">
                                <TextBlock Classes="code" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="small secondary" Text="{Binding TypeText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The selected one -->
        <Panel>
            <c:EmptyState IconKind="edit" Title="{l:T 'No variable selected'}"
                          Description="{l:T 'A project template usually has at least Name (the project folder is named after it).'}"
                          IsVisible="{Binding !HasSelection}" />
            <!-- Visibility on the wrapper: bindings on the element that sets DataContext="{Binding Selected}" are typed as the selected item. -->
            <Border IsVisible="{Binding HasSelection}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Selected}">
                <StackPanel Spacing="{DynamicResource Spacing}" x:DataType="e:VariableItemViewModel"
                            MaxWidth="{DynamicResource Size.TemplatePageMax}" HorizontalAlignment="Left">
                    <c:SettingsRow Label="{l:T 'Name'}" Description="{l:T 'Letters and digits, starting with a letter. Case matters.'}">
                        <StackPanel Spacing="{DynamicResource Spacing.Small}">
                            <TextBox Classes="code" Text="{Binding Name}" AutomationProperties.Name="{l:T 'Variable name'}" />
                            <SelectableTextBlock Classes="small secondary code" Text="{Binding Placeholder}" />
                        </StackPanel>
                    </c:SettingsRow>
                    <c:SettingsRow Label="{l:T 'Label'}" Description="{l:T 'The form\'s label; the name when empty.'}">
                        <TextBox Text="{Binding Label}" AutomationProperties.Name="{l:T 'Label'}" />
                    </c:SettingsRow>
                    <c:SettingsRow Label="{l:T 'Type'}">
                        <ComboBox ItemsSource="{x:Static e:VariableItemViewModel.Types}" SelectedItem="{Binding Type}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Type'}" />
                    </c:SettingsRow>
                    <c:SettingsRow Label="{l:T 'Default'}">
                        <Panel>
                            <TextBox Text="{Binding DefaultText}" IsVisible="{Binding !IsBool}" AutomationProperties.Name="{l:T 'Default'}" />
                            <CheckBox IsChecked="{Binding DefaultBool}" IsVisible="{Binding IsBool}" Content="{l:T 'Checked at first'}"
                                      AutomationProperties.Name="{l:T 'Default'}" />
                        </Panel>
                    </c:SettingsRow>
                    <c:SettingsRow Label="{l:T 'Choices'}" Description="{l:T 'Comma-separated; the user picks one.'}" IsVisible="{Binding IsChoice}">
                        <TextBox Text="{Binding Choices}" AutomationProperties.Name="{l:T 'Choices'}" />
                    </c:SettingsRow>
                    <c:SettingsRow Label="{l:T 'Required'}" IsVisible="{Binding !IsBool}">
                        <CheckBox IsChecked="{Binding Required}" Content="{l:T 'Must be filled in'}" AutomationProperties.Name="{l:T 'Required'}" />
                    </c:SettingsRow>
                    <c:SettingsRow Label="{l:T 'Pattern'}" Description="{l:T 'Optional regular expression the value must match, e.g. ^[A-Za-z][A-Za-z0-9]*$'}"
                                   IsVisible="{Binding IsText}">
                        <TextBox Classes="code" Text="{Binding Pattern}" AutomationProperties.Name="{l:T 'Pattern'}" />
                    </c:SettingsRow>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
