<!--
  Settings → Templates: the author name, where new projects go (a default folder and rules per language and/or
  category), and the template libraries (personal folder, extra folders).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels.Dialogs.Settings"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Dialogs.Settings.TemplatesSettingsPageView"
             x:DataType="vm:TemplatesSettingsPageViewModel">
    <StackPanel Spacing="{DynamicResource Spacing}">
        <c:SettingsRow Label="{l:T 'Author'}" Description="{l:T 'The {{Author}} placeholder. Empty: your Windows user name.'}">
            <TextBox Text="{Binding Author}" PlaceholderText="{Binding AuthorPlaceholder}" AutomationProperties.Name="{l:T 'Author'}" />
        </c:SettingsRow>

        <TextBlock Classes="header" Text="{l:T 'Where new projects go'}" Margin="{DynamicResource Margin.BlockAbove}" />
        <c:SettingsRow Label="{l:T 'Default folder'}" Description="{l:T 'New Project starts here, unless a rule below fits the template. Empty: the folder you used last.'}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                <TextBox Text="{Binding DefaultProjectFolder}" AutomationProperties.Name="{l:T 'Default folder'}" />
                <Button Grid.Column="1" Content="{l:T 'Browse…'}" Command="{Binding BrowseDefaultFolderCommand}" />
            </Grid>
        </c:SettingsRow>
        <TextBlock Classes="small secondary" TextWrapping="Wrap"
                   Text="{l:T 'Rules: a template\'s language, category, or both, and the folder its projects go to. The most specific rule wins (both, then category, then language).'}" />
        <ItemsControl ItemsSource="{Binding Rules}" AutomationProperties.Name="{l:T 'Folder rules'}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderRuleRowViewModel">
                    <Grid ColumnDefinitions="*,*,2*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing.Small}"
                          Margin="{DynamicResource Margin.ListGap}">
                        <AutoCompleteBox Text="{Binding Language, Mode=TwoWay}"
                                         ItemsSource="{Binding $parent[UserControl].((vm:TemplatesSettingsPageViewModel)DataContext).Languages}"
                                         FilterMode="StartsWith" MinimumPrefixLength="0" PlaceholderText="{l:T 'Language'}"
                                         AutomationProperties.Name="{l:T 'Language'}" />
                        <TextBox Grid.Column="1" Text="{Binding Category}" PlaceholderText="{l:T 'Category'}" AutomationProperties.Name="{l:T 'Category'}" />
                        <TextBox Grid.Column="2" Text="{Binding Folder}" PlaceholderText="{l:T 'Folder'}" AutomationProperties.Name="{l:T 'Folder'}" />
                        <Button Grid.Column="3" Content="{l:T 'Browse…'}" Command="{Binding BrowseCommand}" />
                        <c:ActionButton Grid.Column="4" IconKind="close" ToolTip.Tip="{l:T 'Remove'}" AutomationProperties.Name="{l:T 'Remove rule'}"
                                        Command="{Binding RemoveCommand}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="flat" Content="{l:T 'Add Rule'}" Command="{Binding AddRuleCommand}" HorizontalAlignment="Left" />

        <TextBlock Classes="header" Text="{l:T 'Libraries'}" Margin="{DynamicResource Margin.BlockAbove}" />
        <c:SettingsRow Label="{l:T 'Your library'}" Description="{l:T 'Where your own templates are kept. Empty: the default folder shown.'}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                <TextBox Text="{Binding PersonalLibrary}" PlaceholderText="{Binding PersonalLibraryPlaceholder}"
                         AutomationProperties.Name="{l:T 'Your library'}" />
                <Button Grid.Column="1" Content="{l:T 'Browse…'}" Command="{Binding BrowsePersonalLibraryCommand}" />
            </Grid>
        </c:SettingsRow>
        <c:SettingsRow Label="{l:T 'More libraries'}" Description="{l:T 'Folders of templates you share (a team repository, a project\'s templates folder).'}">
            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                <ItemsControl ItemsSource="{Binding ExtraLibraries}" AutomationProperties.Name="{l:T 'More libraries'}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryRowViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                                <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Folder}" />
                                <c:ActionButton Grid.Column="1" IconKind="close" ToolTip.Tip="{l:T 'Remove'}" AutomationProperties.Name="{l:T 'Remove library'}"
                                                Command="{Binding RemoveCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{l:T 'Add Folder…'}" Command="{Binding AddLibraryCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </c:SettingsRow>
    </StackPanel>
</UserControl>
