<!--
  New Project (fills the editor area). Left: the template list on the panel color (search, library and
  kind filters, grouped by category or language). Right: the steps (Details → Commands → Preview → Done)
  and the current page, shown through the ViewLocator (TemplateFormViewModel → TemplateFormView, …).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:DevHub.ViewModels.Documents"
             xmlns:t="using:DevHub.ViewModels.Templates"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Documents.GenerateView"
             x:DataType="docs:GenerateViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.current">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Template list (TemplateBrowserView, through the ViewLocator) -->
        <Border DockPanel.Dock="Left" Width="{DynamicResource Size.TemplateList}"
                Background="{DynamicResource Brush.Bg.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <ContentControl Content="{Binding Browser}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>

        <!-- The generation -->
        <Panel Background="{DynamicResource Brush.Bg.Editor}">
            <c:EmptyState IconKind="add" Title="New Project"
                          Description="Pick a template on the left: fill in its fields, check the commands it runs, arrange the files in the preview, then create."
                          IsVisible="{Binding !HasPage}" />

            <DockPanel Margin="{DynamicResource Padding.Document}" IsVisible="{Binding HasPage}">
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Steps}" Margin="{DynamicResource Margin.BlockBelow}"
                              AutomationProperties.Name="Steps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t:StepIndicatorViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                                <c:Badge Content="{Binding Number}" Classes.accent="{Binding IsCurrent}"
                                         Classes.success="{Binding IsDone}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                           Classes.secondary="{Binding !IsCurrent}" Classes.current="{Binding IsCurrent}" />
                                <TextBlock Classes="secondary" Text="›" VerticalAlignment="Center" IsVisible="{Binding !IsLast}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Content="{Binding Page}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </DockPanel>
        </Panel>
    </DockPanel>
</UserControl>
