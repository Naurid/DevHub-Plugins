<!--
  Import Folder as Template (fills the editor area). Left: the folder, ignore patterns, literal → variable
  replacements, the new template's details, Preview / Create Template. Right: the preview tree (left-out
  items greyed, placeholders per file, the name each file gets in the template).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:docs="using:DevHub.ViewModels.Documents"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Documents.ImportView"
             x:DataType="docs:ImportViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="{DynamicResource Size.ImportSettings}" Background="{DynamicResource Brush.Bg.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="{DynamicResource Spacing}" Margin="{DynamicResource Padding.SidebarHeader}">
                    <Border IsVisible="{Binding HasProblems}" Background="{DynamicResource Brush.Status.Error.Subtle}"
                            CornerRadius="{DynamicResource Radius.Control}" Padding="{DynamicResource Padding.Banner}">
                        <ItemsControl ItemsSource="{Binding Problems}" AutomationProperties.Name="{l:T 'Problems'}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing}">
                        <Button Content="{l:T 'Preview'}" Command="{Binding PreviewCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Classes="accent" Content="{l:T 'Create Template'}" Command="{Binding CreateCommand}" />
                    </Grid>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{DynamicResource Padding.SidebarHeader}" Spacing="{DynamicResource Spacing}">
                        <TextBlock Classes="header" Text="{l:T 'Import Folder as Template'}" />
                        <TextBlock Classes="secondary" Text="{l:T 'Folder'}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                            <TextBox Text="{Binding Folder}" AutomationProperties.Name="{l:T 'Folder'}" />
                            <Button Grid.Column="1" Content="{l:T 'Browse…'}" Command="{Binding BrowseCommand}" />
                        </Grid>

                        <TextBlock Classes="secondary" Text="{l:T 'Becomes a variable'}" Margin="{DynamicResource Margin.BlockAbove}" />
                        <TextBlock Classes="small secondary" TextWrapping="Wrap"
                                   Text="{l:T 'Text in names and files that changes per project. A name of several words is also found in its other spellings (my-game, my_game…).'}" />
                        <ItemsControl ItemsSource="{Binding Replacements}" AutomationProperties.Name="{l:T 'Replacements'}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="docs:ReplacementRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}"
                                          Margin="{DynamicResource Margin.ListGap}">
                                        <TextBox Classes="code" Text="{Binding Literal}" PlaceholderText="{l:T 'LumberjackHollow'}"
                                                 AutomationProperties.Name="{l:T 'Literal'}" />
                                        <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2" Classes="code" Text="{Binding Variable}" PlaceholderText="{l:T 'Name'}"
                                                 AutomationProperties.Name="{l:T 'Variable'}" />
                                        <c:ActionButton Grid.Column="3" IconKind="close" ToolTip.Tip="{l:T 'Remove'}" AutomationProperties.Name="{l:T 'Remove'}"
                                                        Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="flat" Content="{l:T 'Add Replacement'}" Command="{Binding AddReplacementRowCommand}" HorizontalAlignment="Left" />

                        <TextBlock Classes="secondary" Text="{l:T 'Leave out'}" Margin="{DynamicResource Margin.BlockAbove}" />
                        <TextBlock Classes="small secondary" TextWrapping="Wrap"
                                   Text="{l:T 'One pattern per line, like .gitignore: name (anywhere), name/ (folders), /path (from the top), *, **, ?'}" />
                        <TextBox Classes="code" Text="{Binding Ignores}" AcceptsReturn="True" MinHeight="{DynamicResource Size.TemplateArgs}"
                                 AutomationProperties.Name="{l:T 'Leave out'}" />

                        <TextBlock Classes="secondary" Text="{l:T 'Template name'}" Margin="{DynamicResource Margin.BlockAbove}" />
                        <TextBox Text="{Binding Name}" AutomationProperties.Name="{l:T 'Template name'}" />
                        <TextBlock Classes="secondary" Text="{l:T 'Id'}" />
                        <TextBox Classes="code" Text="{Binding Id}" AutomationProperties.Name="{l:T 'Id'}" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Large}">
                            <RadioButton Content="{l:T 'Project'}" IsChecked="{Binding IsProject}" />
                            <RadioButton Content="{l:T 'Item'}" IsChecked="{Binding IsItem}" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{l:T 'Language'}" />
                        <AutoCompleteBox Text="{Binding Language, Mode=TwoWay}" ItemsSource="{Binding Languages}"
                                         FilterMode="StartsWith" MinimumPrefixLength="0" AutomationProperties.Name="{l:T 'Language'}" />
                        <TextBlock Classes="secondary" Text="{l:T 'Categories (comma-separated)'}" />
                        <TextBox Text="{Binding Categories}" AutomationProperties.Name="{l:T 'Categories'}" />
                        <StackPanel Spacing="{DynamicResource Spacing}" IsVisible="{Binding HasSeveralLibraries}">
                            <TextBlock Classes="secondary" Text="{l:T 'Library'}" />
                            <ComboBox ItemsSource="{Binding Libraries}" SelectedItem="{Binding Library}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{l:T 'Library'}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Margin="{DynamicResource Padding.Document}">
            <StackPanel DockPanel.Dock="Top" Spacing="{DynamicResource Spacing}" Margin="{DynamicResource Margin.BlockBelow}">
                <TextBlock Classes="header" Text="{l:T 'Preview'}" />
                <TextBlock Classes="secondary" Text="{Binding Summary}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsBusy}" />
            <Border BorderBrush="{DynamicResource Brush.Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}">
                <TreeView ItemsSource="{Binding Nodes}" Background="Transparent" AutomationProperties.Name="{l:T 'Import preview'}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="docs:ImportNodeViewModel">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                        <Style Selector="Grid.ignored">
                            <Setter Property="Opacity" Value="{DynamicResource Opacity.LeftOut}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="docs:ImportNodeViewModel" ItemsSource="{Binding Children}">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource Spacing.Small}"
                                  Margin="{DynamicResource Margin.RowEnd}" Classes.ignored="{Binding IsIgnored}"
                                  ToolTip.Tip="{Binding Entry.TargetPath}">
                                <Panel Width="{DynamicResource Size.Icon}" VerticalAlignment="Center">
                                    <c:Icon Kind="folder" IsVisible="{Binding IsFolder}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Spacing.Small}"
                                            Margin="{DynamicResource Margin.InnerLeft}">
                                    <TextBlock Classes="small code" Text="{Binding TargetName}" IsVisible="{Binding HasTargetName}"
                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                                    <c:Badge Classes="accent" Content="{Binding HitsText}" IsVisible="{Binding HasHits}" VerticalAlignment="Center" />
                                    <TextBlock Classes="small secondary" Text="{l:T 'left out'}" IsVisible="{Binding IsIgnored}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
