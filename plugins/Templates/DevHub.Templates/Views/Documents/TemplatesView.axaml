<!--
  The Templates tab (fills the editor area). Left: every template (TemplateBrowserView; double-click edits).
  Right: the selected template's summary and what to do with it; New Template… at the top.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:docs="using:DevHub.ViewModels.Documents"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Documents.TemplatesView"
             x:DataType="docs:TemplatesViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="{DynamicResource Size.TemplateList}"
                Background="{DynamicResource Brush.Bg.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <ContentControl Content="{Binding Browser}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>

        <Panel Background="{DynamicResource Brush.Bg.Editor}">
            <c:EmptyState IconKind="template" Title="{l:T 'Templates'}"
                          Description="{l:T 'Pick a template on the left to see it, edit it (double-click) or use it. Built-in templates are read-only: duplicate one to make it yours.'}"
                          IsVisible="{Binding !HasSelection}">
<StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                                    <Button Classes="accent" Content="{l:T 'New Template…'}" Command="{Binding NewTemplateCommand}" />
                    <Button Content="{l:T 'Import Folder…'}" Command="{Binding ImportFolderCommand}" />
                    <Button Content="{l:T 'Import Zip…'}" Command="{Binding ImportZipCommand}" />
                </StackPanel>
            </c:EmptyState>

            <ScrollViewer IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{DynamicResource Padding.Document}" Spacing="{DynamicResource Spacing.Large}"
                            MaxWidth="{DynamicResource Size.TemplatePageMax}" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing}">
                        <c:Icon Kind="template" Width="{DynamicResource Size.StripeIcon}" Height="{DynamicResource Size.StripeIcon}"
                                VerticalAlignment="Center" />
                        <SelectableTextBlock Grid.Column="1" Classes="header" Text="{Binding Selected.Name}" TextWrapping="Wrap"
                                             VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{l:T 'New Template…'}" Command="{Binding NewTemplateCommand}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="{DynamicResource Spacing}">
                        <TextBlock Classes="secondary" Text="{Binding Selected.Description}" TextWrapping="Wrap"
                                   IsVisible="{Binding Selected.HasDescription, FallbackValue=False}" />
                        <WrapPanel Orientation="Horizontal">
                            <c:Badge Classes="accent" Content="{Binding Selected.Language}" Margin="{DynamicResource Margin.RowEnd}"
                                     ToolTip.Tip="{l:T 'Language'}" IsVisible="{Binding !Selected.IsBroken, FallbackValue=False}" />
                            <ItemsControl ItemsSource="{Binding Selected.Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <c:Badge Content="{Binding}" Margin="{DynamicResource Margin.RowEnd}" ToolTip.Tip="{l:T 'Category'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>

                    <Border IsVisible="{Binding Selected.IsBroken, FallbackValue=False}" Background="{DynamicResource Brush.Status.Error.Subtle}"
                            CornerRadius="{DynamicResource Radius.Control}" Padding="{DynamicResource Padding.Banner}">
                        <StackPanel Spacing="{DynamicResource Spacing.Small}">
                            <TextBlock Text="{l:T 'This template can\'t be used until its template.json is fixed (Edit opens it):'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Selected.Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <SelectableTextBlock Classes="code" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="{DynamicResource Spacing.Small}">
                        <c:SettingsRow Label="{l:T 'Kind'}"><TextBlock Text="{Binding Selected.KindText}" TextWrapping="Wrap" /></c:SettingsRow>
                        <c:SettingsRow Label="{l:T 'Base command'}" IsVisible="{Binding Selected.IsProject, FallbackValue=False}">
                            <SelectableTextBlock Classes="code" Text="{Binding Selected.CommandText}" TextWrapping="Wrap" />
                        </c:SettingsRow>
                        <c:SettingsRow Label="{l:T 'Contains'}"><TextBlock Text="{Binding Selected.CountsText}" TextWrapping="Wrap" /></c:SettingsRow>
                        <c:SettingsRow Label="{l:T 'Library'}"><TextBlock Text="{Binding Selected.LibraryText}" /></c:SettingsRow>
                        <c:SettingsRow Label="{l:T 'Folder'}">
                            <SelectableTextBlock Classes="secondary" Text="{Binding Selected.Folder}" TextWrapping="Wrap" />
                        </c:SettingsRow>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="accent" Content="{l:T 'Edit'}" Command="{Binding EditSelectedCommand}" Margin="{DynamicResource Margin.RowEnd}"
                                ToolTip.Tip="{l:T 'Open it in its own editor tab (read-only for built-ins)'}" />
                        <Button Content="{Binding Selected.UseText, FallbackValue=Use}" Command="{Binding UseInNewProjectCommand}" Margin="{DynamicResource Margin.RowEnd}" />
                        <Button Content="{l:T 'Duplicate'}" Command="{Binding DuplicateCommand}" Margin="{DynamicResource Margin.RowEnd}"
                                ToolTip.Tip="{l:T 'A copy in your personal library, which you can change'}" />
                        <Button Content="{l:T 'Show in Explorer'}" Command="{Binding ShowInExplorerCommand}" Margin="{DynamicResource Margin.RowEnd}" />
                        <Button Content="{l:T 'Export…'}" Command="{Binding ExportCommand}" Margin="{DynamicResource Margin.RowEnd}"
                                ToolTip.Tip="{l:T 'Save it as one .zip to share'}" />
                        <Button Content="{l:T 'Delete…'}" Command="{Binding DeleteCommand}"
                                IsVisible="{Binding !Selected.IsReadOnly, FallbackValue=False}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
