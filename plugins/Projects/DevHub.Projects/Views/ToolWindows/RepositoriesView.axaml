<!--
  Projects tool window (ids and class names still say "Repositories"): scan folders as tree roots, repositories as children.
  Right-click a repository to open it / reveal it; right-click a folder to remove it.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels.ToolWindows"
             xmlns:c="using:DevHub.Controls"
             xmlns:a="using:DevHub.Actions"
             x:Class="DevHub.Views.ToolWindows.RepositoriesView"
             x:DataType="vm:RepositoriesViewModel">

    <c:ToolWindowFrame Header="{Binding Title}">
        <c:ToolWindowFrame.HeaderActions>
            <c:Toolbar>
                <c:ActionButton Action="{a:Action Repositories.AddFolder}" />
                <c:ActionButton Action="{a:Action Git.Clone}" />
                <c:ActionButton Action="{a:Action Repositories.Rescan}" />
                <c:ToolbarSeparator />
                <c:ActionButton IconKind="close" ToolTip.Tip="{l:T 'Hide'}" Command="{Binding ToggleCommand}" />
            </c:Toolbar>
        </c:ToolWindowFrame.HeaderActions>

        <DockPanel>
            <c:SearchField DockPanel.Dock="Top" Margin="8,0,8,4"
                           Text="{Binding Filter}"
                           IsVisible="{Binding HasFolders}" />
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2"
                         IsVisible="{Binding IsScanning}" />

            <Panel>
                <c:EmptyState IconKind="folder" Title="{l:T 'No folders yet'}"
                              Description="{l:T 'Add a folder and DevHub finds the projects (git repositories) inside it.'}"
                              IsVisible="{Binding !HasFolders}">
                    <Button Classes="accent" Content="{l:T 'Add Folder…'}" Command="{Binding AddFolderCommand}" />
                </c:EmptyState>

                <TreeView ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Roots}" Background="Transparent"
                          SelectedItem="{Binding SelectedNode}"
                          IsVisible="{Binding HasFolders}">
                    <!-- Enter opens the selected repository as a tab. On the TreeView itself: key
                         events start at the focused row and bubble up to here. -->
                    <TreeView.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding OpenSelectedCommand}" />
                    </TreeView.KeyBindings>
                    <TreeView.Styles>
                        <!-- Two-way: the tree remembers expanded/collapsed on the node. -->
                        <Style Selector="TreeViewItem">
                            <!-- ReflectionBinding: folders, projects and their diagrams all have IsExpanded. -->
                            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            <!-- Screen-reader name (the item's content is a Grid, so it had none).
                                 ReflectionBinding: rows are folders or repositories, and both have a
                                 Name, which a compiled binding typed to one of them can't express. -->
                            <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Name}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <!-- Scan folder (root): children = its repositories. -->
                        <TreeDataTemplate DataType="vm:ScanFolderNode" ItemsSource="{Binding Repositories}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.RowEnd}"
                                  Background="Transparent" ToolTip.Tip="{Binding Path}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T 'Remove Folder'}" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <c:Icon Kind="folder" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <c:Badge Grid.Column="2" Content="{Binding CountText}" />
                            </Grid>
                        </TreeDataTemplate>

                        <!-- Repository. Double-click opens it as a tab (Fork / JetBrains style). Its child is
                             "Diagrams" when the Diagrams plugin is on. -->
                        <TreeDataTemplate DataType="vm:RepositoryNode" ItemsSource="{Binding Children}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.RowEnd}"
                                  Background="Transparent" ToolTip.Tip="{Binding Path}"
                                  c:DoubleTap.Command="{Binding OpenInDevHubCommand}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T 'Open in DevHub'}" Command="{Binding OpenInDevHubCommand}"
                                                  FontWeight="SemiBold">
                                            <MenuItem.Icon><c:Icon Kind="vcs" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Open in External Tool'}" Command="{Binding OpenCommand}">
                                            <MenuItem.Icon><c:Icon Kind="externalTools" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Open in Explorer'}" Command="{Binding RevealCommand}">
                                            <MenuItem.Icon><c:Icon Kind="folder" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Add Files from Template…'}" Command="{Binding AddFilesCommand}"
                                                  IsVisible="{Binding CanAddFiles}">
                                            <MenuItem.Icon><c:Icon Kind="template" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'New Diagram…'}" Command="{Binding NewDiagramCommand}"
                                                  IsVisible="{Binding HasDiagrams}">
                                            <MenuItem.Icon><c:Icon Kind="add" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <c:Icon Kind="vcs" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="small secondary" Text="{Binding Language}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </TreeDataTemplate>

                        <!-- A project's diagrams and mood boards (Diagrams plugin). -->
                        <TreeDataTemplate DataType="vm:ProjectDiagramsNode" ItemsSource="{Binding Items}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.RowEnd}"
                                  Background="Transparent" ToolTip.Tip="{l:T 'Diagrams and mood boards of this project'}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T 'New Diagram…'}" Command="{Binding NewCommand}" FontWeight="SemiBold">
                                            <MenuItem.Icon><c:Icon Kind="add" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T 'Refresh'}" Command="{Binding RefreshCommand}">
                                            <MenuItem.Icon><c:Icon Kind="refresh" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <c:Icon Kind="template" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="secondary"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <c:Badge Grid.Column="2" Content="{Binding CountText}" />
                            </Grid>
                        </TreeDataTemplate>

                        <!-- One diagram: double-click opens it in its tab. -->
                        <DataTemplate DataType="vm:ProjectDiagramNode">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.RowEnd}"
                                  Background="Transparent" ToolTip.Tip="{Binding Path}"
                                  c:DoubleTap.Command="{Binding OpenCommand}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T 'Open'}" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                                        <MenuItem Header="{l:T 'Show in Explorer'}" Command="{Binding RevealCommand}">
                                            <MenuItem.Icon><c:Icon Kind="folder" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{l:T 'Delete…'}" Command="{Binding DeleteCommand}">
                                            <MenuItem.Icon><c:Icon Kind="delete" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <c:Icon Kind="{Binding IconKind}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="small secondary" Text="{Binding KindName}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Panel>
        </DockPanel>
    </c:ToolWindowFrame>
</UserControl>
