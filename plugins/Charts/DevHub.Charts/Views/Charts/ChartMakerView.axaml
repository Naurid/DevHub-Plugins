<!--
  The chart maker: on the left the table (paste cells from Excel, Sheets or Word) and the chart's settings and series
  styles; on the right the chart as it will be exported, with the file and export buttons above.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels.Charts"
             xmlns:charts="using:DevHub.Sdk.Core.Charts"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Charts.ChartMakerView"
             x:DataType="vm:ChartMakerViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="{DynamicResource Padding.Dialog}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{l:T 'New'}" Command="{Binding NewCommand}" Margin="{DynamicResource Margin.RowEnd}" />
                <Button Content="{l:T 'Open…'}" Command="{Binding OpenCommand}" Margin="{DynamicResource Margin.RowEnd}"
                        ToolTip.Tip="{l:T 'A saved chart, or a CSV / tab-separated table'}" />
                <Button Content="{l:T 'Save'}" Command="{Binding SaveCommand}" Margin="{DynamicResource Margin.RowEnd}" />
                <Button Content="{l:T 'Save As…'}" Command="{Binding SaveAsCommand}" Margin="{DynamicResource Margin.RowEnd}" />
                <Button Classes="flat" Content="{l:T 'Sample'}" Command="{Binding SampleCommand}" Margin="{DynamicResource Margin.RowEnd}"
                        ToolTip.Tip="{l:T 'A small example to start from'}" />
                <Button Classes="accent" Content="{l:T 'Save Image…'}" Command="{Binding SaveImageCommand}" Margin="{DynamicResource Margin.RowEnd}"
                        ToolTip.Tip="{l:T 'A PNG for your document (light, sharp when printed)'}" />
                <Button Content="{l:T 'Copy Image'}" Command="{Binding CopyImageCommand}" Margin="{DynamicResource Margin.RowEnd}" />
                <Button Classes="flat" Content="{l:T 'Copy Table'}" Command="{Binding CopyTableCommand}" />
            </WrapPanel>
        </Border>

        <!-- The table and the settings. -->
        <c:SidePane PaneWidth="{DynamicResource Size.ChartMakerPanel}" MinPaneWidth="240" MinContentWidth="360"
                    PaneIcon="settings" PaneTitle="{l:T 'Chart settings'}">
            <c:SidePane.Pane>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{DynamicResource Padding.Dialog}" Spacing="{DynamicResource Spacing.Small}">
                        <TextBlock Classes="label" Text="{l:T 'Table: first row the series, first column the labels'}" />
                        <TextBox Text="{Binding Table}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" Classes="code"
                                 MinHeight="{DynamicResource Size.DescriptionEditor}" AutomationProperties.Name="{l:T 'Table'}" />
                        <CheckBox Content="{l:T 'Each row is a series'}" IsChecked="{Binding SeriesInRows}" />

                        <TextBlock Classes="label" Text="{l:T 'Chart type'}" />
                        <ComboBox ItemsSource="{Binding KindChoices}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Chart type'}" />
                        <CheckBox Content="{l:T 'Green, amber, red (risk matrix)'}" IsChecked="{Binding TrafficColors}" IsVisible="{Binding IsHeatmap}" />
                        <TextBlock Classes="label" Text="{l:T 'Title'}" />
                        <TextBox Text="{Binding ChartTitle}" AutomationProperties.Name="{l:T 'Title'}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Spacing}">
                            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                                <TextBlock Classes="label" Text="{l:T 'Label axis'}" />
                                <TextBox Text="{Binding XTitle}" PlaceholderText="{l:T 'e.g. Sprint'}" AutomationProperties.Name="{l:T 'Label axis title'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.Small}">
                                <TextBlock Classes="label" Text="{l:T 'Value axis'}" />
                                <TextBox Text="{Binding YTitle}" PlaceholderText="{l:T 'e.g. Story points'}" AutomationProperties.Name="{l:T 'Value axis title'}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="label" Text="{l:T 'After each value'}" />
                        <TextBox Text="{Binding ValueSuffix}" PlaceholderText="{l:T 'e.g. % or  pts'}" AutomationProperties.Name="{l:T 'Value suffix'}" />

                        <TextBlock Classes="section" Text="{l:T 'Series'}" IsVisible="{Binding HasChart}" />
                        <ItemsControl ItemsSource="{Binding Series}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SeriesStyleRow">
                                    <StackPanel Spacing="{DynamicResource Spacing.Small}" Margin="{DynamicResource Margin.BlockBelow}">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Spacing.Small}">
                                            <ComboBox ItemsSource="{x:Static vm:SeriesStyleRow.Dashes}" SelectedItem="{Binding Dash}" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="{l:T 'Line'}" AutomationProperties.Name="{l:T 'Line'}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SeriesStyleRow.Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="{l:T 'In a bars-and-lines chart: drawn as'}" AutomationProperties.Name="{l:T 'Drawn as'}" />
                                            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:SeriesStyleRow.Colors}" SelectedItem="{Binding Color}" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="{l:T 'Color'}" AutomationProperties.Name="{l:T 'Color'}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                                            <CheckBox Content="{l:T 'Markers'}" IsChecked="{Binding Markers}" />
                                            <CheckBox Content="{l:T 'Values'}" IsChecked="{Binding ValueLabels}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </c:SidePane.Pane>
            <DockPanel>
                <!-- The chart. -->
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Padding="{DynamicResource Padding.Dialog}">
                    <Panel>
                        <c:EmptyState IconKind="info" Title="{l:T 'Nothing to draw yet'}" Description="{Binding Problem}" IsVisible="{Binding !HasChart}" />
                        <DockPanel IsVisible="{Binding HasChart}">
                            <TextBlock DockPanel.Dock="Top" Classes="header" Text="{Binding ChartTitle}" HorizontalAlignment="Center"
                                       Margin="{DynamicResource Margin.BlockBelow}"
                                       IsVisible="{Binding ChartTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <c:Chart Kind="{Binding Kind.Kind, FallbackValue=Bar}" Data="{Binding Data}" />
                        </DockPanel>
                    </Panel>
                </Border>
            </DockPanel>
        </c:SidePane>
    </DockPanel>
</UserControl>
